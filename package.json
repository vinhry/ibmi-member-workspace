{
  "name": "ibmi-member-workspace",
  "displayName": "IBM i Member Workspace",
  "description": "Work with IBM i source members locally, compare changes, and synchronize them safely. Works with Code for IBM i.",
  "version": "1.5.0",
  "publisher": "vinhry",
  "author": "Vinhry",
  "license": "GPL-3.0",
  "pricing": "Free",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/vinhry/ibmi-member-workspace.git"
  },
  "bugs": {
    "url": "https://github.com/vinhry/ibmi-member-workspace/issues"
  },
  "homepage": "https://github.com/vinhry/ibmi-member-workspace#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "ibmi",
    "as400",
    "iseries",
    "rpgle",
    "cobol",
    "source member",
    "checkout"
  ],
  "extensionDependencies": [
    "halcyontechltd.code-for-ibmi"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "submenus": [
      {
        "id": "ibmi-member-workspace.compareWith",
        "label": "Compare With"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ibmi-member-workspace",
          "title": "Member Workspace",
          "icon": "resources/checkout.svg"
        }
      ]
    },
    "views": {
      "ibmi-member-workspace": [
        {
          "id": "ibmi-member-workspace.checkoutView",
          "name": "Checked Out Members",
          "when": "code-for-ibmi:connected",
          "icon": "resources/checkout.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "ibmi-member-workspace.checkoutView",
        "contents": "Choose where checked-out member files will be stored for this workspace.\n[Choose Checkout Folder](command:ibmi-member-workspace.configureCheckoutFolder)",
        "when": "!ibmi-member-workspace:checkoutFolderConfigured"
      },
      {
        "view": "ibmi-member-workspace.checkoutView",
        "contents": "No members are checked out yet.\nRight-click a source member (or a source file) in the Code for IBM i Object Browser and choose Check Out.",
        "when": "ibmi-member-workspace:checkoutFolderConfigured"
      }
    ],
    "commands": [
      {
        "command": "ibmi-member-workspace.checkoutMember",
        "title": "Check Out Member",
        "category": "IBM i Member Workspace"
      },
      {
        "command": "ibmi-member-workspace.checkoutAllMembers",
        "title": "Check Out All Members",
        "category": "IBM i Member Workspace"
      },
      {
        "command": "ibmi-member-workspace.findDependencies",
        "title": "Find Dependencies…",
        "category": "IBM i Member Workspace"
      },
      {
        "command": "ibmi-member-workspace.toggleAutoUpload",
        "title": "Change Upload on Save",
        "category": "IBM i Member Workspace"
      },
      {
        "command": "ibmi-member-workspace.configureCheckoutFolder",
        "title": "Configure Checkout Folder",
        "category": "IBM i Member Workspace",
        "icon": "$(folder-opened)"
      },
      {
        "command": "ibmi-member-workspace.mergeBack",
        "title": "Merge Back to IBM i",
        "category": "IBM i Member Workspace",
        "icon": "$(diff)"
      },
      {
        "command": "ibmi-member-workspace.openLocalFile",
        "title": "Open Local File",
        "category": "IBM i Member Workspace",
        "icon": "$(go-to-file)"
      },
      {
        "command": "ibmi-member-workspace.revealInExplorer",
        "title": "Reveal in File Explorer",
        "category": "IBM i Member Workspace"
      },
      {
        "command": "ibmi-member-workspace.refreshRemote",
        "title": "Refresh Remote Status",
        "category": "IBM i Member Workspace",
        "icon": "$(sync)"
      },
      {
        "command": "ibmi-member-workspace.discardCheckout",
        "title": "Discard Checkout",
        "category": "IBM i Member Workspace",
        "icon": "$(trash)"
      },
      {
        "command": "ibmi-member-workspace.copyMemberPath",
        "title": "Copy Member Path",
        "category": "IBM i Member Workspace"
      },
      {
        "command": "ibmi-member-workspace.selectForCompare",
        "title": "Select for Compare",
        "category": "IBM i Member Workspace"
      },
      {
        "command": "ibmi-member-workspace.compareWithActive",
        "title": "Compare with Active File",
        "category": "IBM i Member Workspace"
      },
      {
        "command": "ibmi-member-workspace.compareWithSelected",
        "title": "Compare with Selected",
        "category": "IBM i Member Workspace"
      },
      {
        "command": "ibmi-member-workspace.compareWithLocalFile",
        "title": "Compare with Local File",
        "category": "IBM i Member Workspace"
      },
      {
        "command": "ibmi-member-workspace.compareWithIfsFile",
        "title": "Compare with IFS File",
        "category": "IBM i Member Workspace"
      },
      {
        "command": "ibmi-member-workspace.compareWithMember",
        "title": "Compare with Member",
        "category": "IBM i Member Workspace"
      },
      {
        "command": "ibmi-member-workspace.openRemoteFile",
        "title": "Open Remote File",
        "category": "IBM i Member Workspace"
      },
      {
        "command": "ibmi-member-workspace.uploadToRemote",
        "title": "Upload to IBM i",
        "category": "IBM i Member Workspace",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "ibmi-member-workspace.runAction",
        "title": "Run Action",
        "category": "IBM i Member Workspace",
        "icon": "$(play)"
      },
      {
        "command": "ibmi-member-workspace.refreshSourceFileRemote",
        "title": "Refresh Remote Status",
        "category": "IBM i Member Workspace",
        "icon": "$(sync)"
      },
      {
        "command": "ibmi-member-workspace.refreshAllRemote",
        "title": "Refresh All Remote Status",
        "category": "IBM i Member Workspace",
        "icon": "$(sync)"
      },
      {
        "command": "ibmi-member-workspace.refreshView",
        "title": "Refresh",
        "category": "IBM i Member Workspace",
        "icon": "$(refresh)"
      },
      {
        "command": "ibmi-member-workspace.expandAll",
        "title": "Expand All",
        "category": "IBM i Member Workspace",
        "icon": "$(expand-all)"
      },
      {
        "command": "ibmi-member-workspace.search",
        "title": "Search Checked Out Members",
        "category": "IBM i Member Workspace",
        "icon": "$(search)"
      },
      {
        "command": "ibmi-member-workspace.clearSearch",
        "title": "Clear Search Filter",
        "category": "IBM i Member Workspace",
        "icon": "$(clear-all)"
      },
      {
        "command": "ibmi-member-workspace.selectGitBranch",
        "title": "Switch Work Item",
        "category": "IBM i Member Workspace",
        "icon": "$(git-branch)"
      },
      {
        "command": "ibmi-member-workspace.commitNow",
        "title": "Save Checkpoint",
        "category": "IBM i Member Workspace",
        "icon": "$(git-commit)"
      },
      {
        "command": "ibmi-member-workspace.moveToWorkItem",
        "title": "Move to Work Item\u2026",
        "category": "IBM i Member Workspace",
        "icon": "$(git-branch)"
      },
      {
        "command": "ibmi-member-workspace.setupGitIntegration",
        "title": "Set Up Local Change History",
        "category": "IBM i Member Workspace",
        "icon": "$(history)"
      },
      {
        "command": "ibmi-member-workspace.viewGitHistory",
        "title": "View Local History",
        "category": "IBM i Member Workspace",
        "icon": "$(history)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "ibmi-member-workspace.checkoutMember",
          "when": "false"
        },
        {
          "command": "ibmi-member-workspace.findDependencies",
          "when": "false"
        },
        {
          "command": "ibmi-member-workspace.checkoutAllMembers",
          "when": "false"
        },
        {
          "command": "ibmi-member-workspace.mergeBack",
          "when": "false"
        },
        {
          "command": "ibmi-member-workspace.openLocalFile",
          "when": "false"
        },
        {
          "command": "ibmi-member-workspace.refreshRemote",
          "when": "false"
        },
        {
          "command": "ibmi-member-workspace.discardCheckout",
          "when": "false"
        },
        {
          "command": "ibmi-member-workspace.copyMemberPath",
          "when": "false"
        },
        {
          "command": "ibmi-member-workspace.refreshView",
          "when": "false"
        },
        {
          "command": "ibmi-member-workspace.selectForCompare",
          "when": "false"
        },
        {
          "command": "ibmi-member-workspace.compareWithActive",
          "when": "false"
        },
        {
          "command": "ibmi-member-workspace.compareWithSelected",
          "when": "false"
        },
        {
          "command": "ibmi-member-workspace.compareWithLocalFile",
          "when": "false"
        },
        {
          "command": "ibmi-member-workspace.compareWithIfsFile",
          "when": "false"
        },
        {
          "command": "ibmi-member-workspace.compareWithMember",
          "when": "false"
        },
        {
          "command": "ibmi-member-workspace.revealInExplorer",
          "when": "false"
        },
        {
          "command": "ibmi-member-workspace.runAction",
          "when": "false"
        },
        {
          "command": "ibmi-member-workspace.openRemoteFile",
          "when": "false"
        },
        {
          "command": "ibmi-member-workspace.uploadToRemote",
          "when": "false"
        },
        {
          "command": "ibmi-member-workspace.refreshAllRemote",
          "when": "false"
        },
        {
          "command": "ibmi-member-workspace.refreshSourceFileRemote",
          "when": "false"
        },
        {
          "command": "ibmi-member-workspace.expandAll",
          "when": "false"
        },
        {
          "command": "ibmi-member-workspace.search",
          "when": "false"
        },
        {
          "command": "ibmi-member-workspace.clearSearch",
          "when": "false"
        },
        {
          "command": "ibmi-member-workspace.commitNow",
          "when": "false"
        },
        {
          "command": "ibmi-member-workspace.viewGitHistory",
          "when": "false"
        },
        {
          "command": "ibmi-member-workspace.moveToWorkItem",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "ibmi-member-workspace.checkoutMember",
          "when": "view == objectBrowser && (viewItem == member || (viewItem == member_readonly && config.ibmi-member-workspace.allowCheckoutFromProtectedFilter))",
          "group": "ibmiCheckout@1"
        },
        {
          "command": "ibmi-member-workspace.checkoutAllMembers",
          "when": "view == objectBrowser && (viewItem == SPF || (viewItem == SPF_readonly && config.ibmi-member-workspace.allowCheckoutFromProtectedFilter))",
          "group": "ibmiCheckout@1"
        },
        {
          "command": "ibmi-member-workspace.refreshRemote",
          "when": "view == ibmi-member-workspace.checkoutView && viewItem =~ /^(checkout|reference)/",
          "group": "inline@1"
        },
        {
          "command": "ibmi-member-workspace.mergeBack",
          "when": "view == ibmi-member-workspace.checkoutView && viewItem =~ /^checkout/ && !listMultiSelection",
          "group": "inline@2"
        },
        {
          "command": "ibmi-member-workspace.openLocalFile",
          "when": "view == ibmi-member-workspace.checkoutView && viewItem =~ /^(checkout|reference)/",
          "group": "1_open@1"
        },
        {
          "command": "ibmi-member-workspace.openRemoteFile",
          "when": "view == ibmi-member-workspace.checkoutView && viewItem =~ /^(checkout|reference)/",
          "group": "1_open@2"
        },
        {
          "command": "ibmi-member-workspace.revealInExplorer",
          "when": "view == ibmi-member-workspace.checkoutView && viewItem =~ /^(checkout|reference)/ && !listMultiSelection",
          "group": "1_open@3"
        },
        {
          "command": "ibmi-member-workspace.mergeBack",
          "when": "view == ibmi-member-workspace.checkoutView && viewItem =~ /^checkout/ && !listMultiSelection",
          "group": "2_merge@1"
        },
        {
          "command": "ibmi-member-workspace.uploadToRemote",
          "when": "view == ibmi-member-workspace.checkoutView && viewItem =~ /^checkout/",
          "group": "2_merge@2"
        },
        {
          "command": "ibmi-member-workspace.runAction",
          "when": "view == ibmi-member-workspace.checkoutView && viewItem =~ /^checkout/",
          "group": "2_merge@3"
        },
        {
          "command": "ibmi-member-workspace.selectForCompare",
          "when": "view == ibmi-member-workspace.checkoutView && viewItem =~ /^(checkout|reference)/ && !listMultiSelection",
          "group": "3_compare@1"
        },
        {
          "submenu": "ibmi-member-workspace.compareWith",
          "when": "view == ibmi-member-workspace.checkoutView && viewItem =~ /^(checkout|reference)/ && !listMultiSelection",
          "group": "3_compare@2"
        },
        {
          "command": "ibmi-member-workspace.refreshRemote",
          "when": "view == ibmi-member-workspace.checkoutView && viewItem =~ /^(checkout|reference)/",
          "group": "4_status@1"
        },
        {
          "command": "ibmi-member-workspace.findDependencies",
          "when": "view == ibmi-member-workspace.checkoutView && viewItem =~ /^(checkout|reference)/ && !listMultiSelection",
          "group": "4_status@2"
        },
        {
          "command": "ibmi-member-workspace.copyMemberPath",
          "when": "view == ibmi-member-workspace.checkoutView && viewItem =~ /^(checkout|reference)/ && !listMultiSelection",
          "group": "5_util@1"
        },
        {
          "command": "ibmi-member-workspace.commitNow",
          "when": "view == ibmi-member-workspace.checkoutView && viewItem =~ /^checkout/ && !listMultiSelection && config.ibmi-member-workspace.gitIntegration",
          "group": "2_merge@4"
        },
        {
          "command": "ibmi-member-workspace.moveToWorkItem",
          "when": "view == ibmi-member-workspace.checkoutView && viewItem =~ /^(checkout|reference)/ && config.ibmi-member-workspace.gitIntegration",
          "group": "2_merge@5"
        },
        {
          "command": "ibmi-member-workspace.discardCheckout",
          "when": "view == ibmi-member-workspace.checkoutView && viewItem =~ /^(checkout|reference)/",
          "group": "6_danger@1"
        },
        {
          "command": "ibmi-member-workspace.refreshSourceFileRemote",
          "when": "view == ibmi-member-workspace.checkoutView && viewItem == sourceFileGroup",
          "group": "inline"
        },
        {
          "command": "ibmi-member-workspace.refreshSourceFileRemote",
          "when": "view == ibmi-member-workspace.checkoutView && viewItem == sourceFileGroup",
          "group": "1_status@1"
        }
      ],
      "ibmi-member-workspace.compareWith": [
        {
          "command": "ibmi-member-workspace.compareWithActive",
          "group": "compare@1"
        },
        {
          "command": "ibmi-member-workspace.compareWithSelected",
          "when": "ibmi-member-workspace:hasCompareSelection",
          "group": "compare@2"
        },
        {
          "command": "ibmi-member-workspace.compareWithLocalFile",
          "group": "compare@3"
        },
        {
          "command": "ibmi-member-workspace.compareWithIfsFile",
          "group": "compare@4"
        },
        {
          "command": "ibmi-member-workspace.compareWithMember",
          "group": "compare@5"
        }
      ],
      "view/title": [
        {
          "command": "ibmi-member-workspace.configureCheckoutFolder",
          "when": "view == ibmi-member-workspace.checkoutView",
          "group": "navigation@0"
        },
        {
          "command": "ibmi-member-workspace.refreshAllRemote",
          "when": "view == ibmi-member-workspace.checkoutView",
          "group": "navigation@1"
        },
        {
          "command": "ibmi-member-workspace.refreshView",
          "when": "view == ibmi-member-workspace.checkoutView",
          "group": "navigation@2"
        },
        {
          "command": "ibmi-member-workspace.expandAll",
          "when": "view == ibmi-member-workspace.checkoutView",
          "group": "navigation@3"
        },
        {
          "command": "ibmi-member-workspace.search",
          "when": "view == ibmi-member-workspace.checkoutView && !ibmi-member-workspace:searchActive",
          "group": "navigation@4"
        },
        {
          "command": "ibmi-member-workspace.clearSearch",
          "when": "view == ibmi-member-workspace.checkoutView && ibmi-member-workspace:searchActive",
          "group": "navigation@4"
        },
        {
          "command": "ibmi-member-workspace.selectGitBranch",
          "when": "view == ibmi-member-workspace.checkoutView && ibmi-member-workspace:checkoutFolderConfigured && config.ibmi-member-workspace.gitIntegration",
          "group": "navigation@5"
        },
        {
          "command": "ibmi-member-workspace.setupGitIntegration",
          "when": "view == ibmi-member-workspace.checkoutView && ibmi-member-workspace:checkoutFolderConfigured && !config.ibmi-member-workspace.gitIntegration",
          "group": "navigation@5"
        },
        {
          "command": "ibmi-member-workspace.viewGitHistory",
          "when": "view == ibmi-member-workspace.checkoutView && config.ibmi-member-workspace.gitIntegration",
          "group": "navigation@6"
        }
      ]
    },
    "configuration": {
      "title": "IBM i Member Workspace",
      "properties": {
        "ibmi-member-workspace.warnOnRedownload": {
          "type": "boolean",
          "default": true,
          "description": "Show warning when checking out a member that is already checked out."
        },
        "ibmi-member-workspace.autoOpenOnCheckout": {
          "type": "boolean",
          "default": true,
          "description": "Automatically open the file in the editor after checkout."
        },
        "ibmi-member-workspace.allowCheckoutFromProtectedFilter": {
          "type": "boolean",
          "default": false,
          "description": "Allow checking out source members from protected (read-only) filters. Off by default to prevent accidental edits to protected sources."
        },
        "ibmi-member-workspace.autoUploadOnSave": {
          "type": "string",
          "enum": [
            "off",
            "ask",
            "silent"
          ],
          "enumDescriptions": [
            "Upload only with the Upload to IBM i command.",
            "Ask before uploading a checked-out member each time you save it.",
            "Upload a checked-out member whenever you save it, without asking."
          ],
          "default": "off",
          "markdownDescription": "Upload a checked-out member to the IBM i when you save it in the editor. Only saves with local changes upload, and a member changed on the IBM i since checkout always asks before it is overwritten. Files changed by other tools are never uploaded automatically."
        },
        "ibmi-member-workspace.gitIntegration": {
          "type": "boolean",
          "default": false,
          "description": "Keep local checkpoints organized by work item in one Git repository per IBM i system directory. Does not upload or push changes."
        },
        "ibmi-member-workspace.dependencies.suggestAfterCheckout": {
          "type": "boolean",
          "default": true,
          "description": "After checking out a single member, offer to review the copybooks, called programs, and referenced files it uses. Nothing is downloaded until you choose."
        },
        "ibmi-member-workspace.dependencies.searchLibraries": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Libraries to search, in order, for the source members and compiled programs of dependencies found by **Find Dependencies**, for example your production object and source libraries (`PRODOBJ`, `PRODSRC`). When empty, the connection's current library and library list are searched."
        },
        "ibmi-member-workspace.dependencies.sources": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "source",
              "programReferences",
              "crossReferences"
            ],
            "enumDescriptions": [
              "Scan the member's local source text.",
              "Run DSPPGMREF on the compiled program in the search libraries.",
              "Run the queries in dependencies.crossReferences (for example, against Abstract)."
            ]
          },
          "uniqueItems": true,
          "default": [
            "source",
            "programReferences",
            "crossReferences"
          ],
          "markdownDescription": "Where **Find Dependencies** looks. Each source is also checked on the connected IBM i and left out when it isn't available there (for example, no compiled program, or a cross-reference tool that isn't installed)."
        },
        "ibmi-member-workspace.dependencies.crossReferences": {
          "type": "array",
          "scope": "application",
          "default": [],
          "items": {
            "type": "object",
            "required": [
              "name",
              "query"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Shown in Find Dependencies, for example \"Abstract\"."
              },
              "query": {
                "type": "string",
                "description": "A SELECT statement. Placeholders {library}, {sourceFile}, {member} and {object} are passed as parameters. Return KIND (copybook, program, file, or an object type such as *FILE or *PGM) and MEMBER or OBJECT; optionally LIBRARY and SOURCE_FILE (the source member's location), LINE and TEXT."
              },
              "systems": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Host names this query applies to. Empty means every system."
              },
              "requiresLibrary": {
                "type": "string",
                "description": "Only use this query on systems where this library exists, for example the library holding the tool's cross-reference files."
              }
            }
          },
          "markdownDescription": "Cross-reference tools to ask in **Find Dependencies**, such as Abstract, Pathfinder or MDXREF. Each entry is a SQL `SELECT` against the tool's files; see **Dependencies** in the README for the columns and an example. Only user settings are read, so a workspace can't add queries."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "test": "npm run compile && node --test \"out/test/**/*.test.js\"",
    "package": "vsce package",
    "package:list": "vsce ls"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@halcyontech/vscode-ibmi-types": "^3.0.13",
    "@types/node": "^20.19.43",
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "4.0.0",
    "eslint": "^10.11.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "allowScripts": {
    "@vscode/vsce-sign@2.1.0": true
  }
}
